# ====================================================================
# ADANI WEBSITE MONITORING & UPTIME ANALYTICS - ENVIRONMENT VARIABLES
# ====================================================================

# Application
PROJECT_NAME="Adani Website Monitoring & Uptime Analytics"
HOST=0.0.0.0
PORT=8008
API_V1_STR=/dashboard/api
SECRET_KEY=adani-monitoring-super-secret-jwt-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/adani_monitoring
FALLBACK_SQLITE_URL=sqlite:///./adani_monitoring.db

# Monitoring Worker Engine
MONITOR_WORKER_ENABLED=true
MONITOR_LOOP_INTERVAL_SECONDS=15
DEFAULT_MONITOR_INTERVAL_SECONDS=3600
DEFAULT_TIMEOUT_SECONDS=10
WARNING_RESPONSE_TIME_MS=2000
SSL_WARNING_DAYS=14

# Email & Alerting (SMTP)
SMTP_SERVER=smtp.adani.com
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=farhan.vhora@adani.com
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_ENABLED=false

# Admin Daily Report Schedule 
DAILY_REPORT_TIME=10:00
DAILY_REPORT_TIMEZONE=Asia/Kolkata
DAILY_REPORT_RECIPIENTS=farhanvhora@cognitbotz.com
