# Copy to .env and fill in. LLM_PROVIDER picks which backend agents/llm.py uses.

# ------------------------------------------------------------------
# LLM_PROVIDER=azure  — Azure OpenAI via the curl bridge (agents/azure_curl.py).
# Required on the secured Adani VM: Python's requests/httpx can't complete
# TLS to the internal endpoint there, but the system curl.exe (Schannel,
# uses the OS certificate store) can — so this path shells out to curl.
# ------------------------------------------------------------------
LLM_PROVIDER=azure
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2023-12-01-preview

# ------------------------------------------------------------------
# LLM_PROVIDER=nvidia — NVIDIA NIM via langchain's ChatOpenAI (original
# provider; still works for local dev off the restricted VM). Ignored
# unless LLM_PROVIDER=nvidia above. The API key can also be set from
# Settings → AI Config in the app instead of here.
# ------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=poolside/laguna-xs-2.1
